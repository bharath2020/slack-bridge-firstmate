#!/usr/bin/env python3
"""Fake taskpolicy: records argv; exits 1 for a pid listed in $FAKE_SYS_DIR/gone.
`taskpolicy -b <program> [args]` runs the program, as the real one does."""
import json, os, sys
from pathlib import Path

d = Path(os.environ["FAKE_SYS_DIR"])
with (d / "calls.log").open("a") as fh:
    fh.write(json.dumps(["taskpolicy", *sys.argv[1:]]) + "\n")
if len(sys.argv) > 2 and sys.argv[1] == "-b" and sys.argv[2] != "-p":
    os.execv(sys.argv[2], sys.argv[2:])
gone = (d / "gone").read_text().split() if (d / "gone").exists() else []
sys.exit(1 if sys.argv[-1] in gone else 0)
